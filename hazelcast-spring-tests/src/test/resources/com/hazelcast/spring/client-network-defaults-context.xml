<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:hz="http://www.hazelcast.com/schema/spring"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.hazelcast.com/schema/spring
        http://www.hazelcast.com/schema/spring/hazelcast-spring-5.2.xsd">

    <hz:hazelcast id="instance">
        <hz:config>
            <hz:cluster-name>client-network-default</hz:cluster-name>
            <!-- Pin the member to 127.0.0.1:5701 (auto-increments only if that
                 port is taken) and advertise that address to clients. Other
                 Spring tests running earlier in the same JVM start members from
                 their XML but never shut them down, so on CI 5701-5703 can be
                 held by foreign-cluster members and this member would land on a
                 higher port which an addressless client never probes. Same
                 hardening as on upstream master. -->
            <hz:network port="5701" public-address="127.0.0.1"/>
        </hz:config>
    </hz:hazelcast>

    <hz:client id="client">
        <hz:cluster-name>client-network-default</hz:cluster-name>
        <hz:network>
            <!-- Explicit address list: a client without <hz:member> entries
                 resolves to 127.0.0.1:5701-5703 only (3 port tries), which is
                 not enough when the member above auto-incremented past 5703. -->
            <hz:member>127.0.0.1:5701</hz:member>
            <hz:member>127.0.0.1:5702</hz:member>
            <hz:member>127.0.0.1:5703</hz:member>
            <hz:member>127.0.0.1:5704</hz:member>
            <hz:member>127.0.0.1:5705</hz:member>
            <hz:member>127.0.0.1:5706</hz:member>
            <hz:member>127.0.0.1:5707</hz:member>
            <hz:member>127.0.0.1:5708</hz:member>
            <hz:member>127.0.0.1:5709</hz:member>
        </hz:network>
    </hz:client>

</beans>
